# =========================================================
# StudyWiser Ops — environment configuration
# Copy this file to `.env.local` and adjust as needed.
# =========================================================

# --- Local demo mode (default) ---
# When true, the app runs with NO backend: authentication is bypassed and a
# demo user is used, so `npm install && npm run dev` boots straight into the
# dashboard. Nothing else in this file is needed while this is true.
# Set it to false to turn on real Supabase authentication + data (below).
NEXT_PUBLIC_DEMO_MODE=true

# --- Supabase (only needed when NEXT_PUBLIC_DEMO_MODE=false) ---
# These two NEXT_PUBLIC_ values are safe to expose to the browser: the anon key
# is only useful together with Row Level Security, which this app enforces on
# every table. NEVER put the Supabase service-role key in a NEXT_PUBLIC_
# variable or commit it to git.
#
# For local development with `supabase start`, the values below are the standard
# public defaults the Supabase CLI prints for every local instance.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# Absolute base URL of the running app; used to build password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Production (hosted Supabase project) ---
# Set NEXT_PUBLIC_DEMO_MODE=false and replace the three values above with your
# isolated Ops project's settings:
#   NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-project-anon-key>
#   NEXT_PUBLIC_SITE_URL=https://<your-deployed-domain>
